\newcommand{\IDMatrix}[4]{%
  % #1 = framebox width
  % #2 = code infix
  % #3 = row label prefix
  % #4 = number of rows
  \setlength{\extrarowheight}{4mm}
  \begin{center}
  \begin{tabular}{ c c c c c c c c c c c}
  & 1 & 2 & 3 & 4 & 5 & 6 & 7 & 8 & 9 & 0\\
  \IDMatrixRows{#1}{#2}{#3}{#4}{1}%
  \end{tabular}
  \end{center}
}

\newcommand{\IDMatrixRows}[5]{%
  % #1 width, #2 infix, #3 label, #4 total rows, #5 current row
  #3 \##5 &
  \framebox{\matcode{N#2\number\numexpr#5-1\relax1}} &
  \framebox{\matcode{N#2\number\numexpr#5-1\relax2}} &
  \framebox{\matcode{N#2\number\numexpr#5-1\relax3}} &
  \framebox{\matcode{N#2\number\numexpr#5-1\relax4}} &
  \framebox{\matcode{N#2\number\numexpr#5-1\relax5}} &
  \framebox{\matcode{N#2\number\numexpr#5-1\relax6}} &
  \framebox{\matcode{N#2\number\numexpr#5-1\relax7}} &
  \framebox{\matcode{N#2\number\numexpr#5-1\relax8}} &
  \framebox{\matcode{N#2\number\numexpr#5-1\relax9}} &
  \framebox{\matcode{N#2\number\numexpr#5-1\relax0}}%
  \ifnum#5<#4
    \\[5pt]
    \IDMatrixRows{#1}{#2}{#3}{#4}{\number\numexpr#5+1\relax}%
  \fi
}

\newcommand{\qrgraderpagestyle}[2]{
    \fancyhf{}

    \pagenumbering{arabic}

    \fancyhead[L]{#2}
    \fancyhead[C]{#1\\[-1pt]}
    \fancyhead[R]{\uniqueid\uniqueqr\\[-10pt]}
    \fancyfoot[C]{\thepage}
    \fancyfoot[L]{\uniqueqrQ}
    \renewcommand{\headrulewidth}{0.8pt}
    \renewcommand{\footrulewidth}{0.8pt}
    \pagestyle{fancy}
}



\ExplSyntaxOn

\tl_new:N \l_codebox_height_tl
\tl_new:N \l_codebox_width_tl
\tl_set:Nn \l_codebox_width_tl { 0.985\textwidth }

\keys_define:nn { codebox }
 {
  height .tl_set:N = \l_codebox_height_tl,
  height .initial:n = { },
  width  .tl_set:N = \l_codebox_width_tl,
  width  .initial:n = { 0.985\textwidth },
 }

\NewDocumentCommand{\codebox}{O{}m}
 {
  \par
  \group_begin:
  \keys_set:nn { codebox } { #1 }
  \fbox{
    \tl_if_empty:NTF \l_codebox_height_tl
     {
      \begin{minipage}{\l_codebox_width_tl}
     }
     {
      \begin{minipage}[t][\l_codebox_height_tl]{\l_codebox_width_tl}
     }
    \ttfamily
    \tl_set:Nn \l_tmpa_tl { #2 }
    \regex_replace_all:nnN { \*\*\* } { ...<BREAK> } \l_tmpa_tl
    \regex_replace_all:nnN { @HEADER@ } {-----------------------------su-solución-debajo-de-esta-línea----------------------------<BREAK> } \l_tmpa_tl
    %\regex_replace_all:nnN { :: } { <LITCOLON> } \l_tmpa_tl
    %\regex_replace_all:nnN { : } { :<BREAK> } \l_tmpa_tl
    \regex_replace_all:nnN { ; } { <BREAK> } \l_tmpa_tl
    \regex_replace_all:nnN { <LITCOLON> } { : } \l_tmpa_tl
    \seq_set_split:Nne \l_tmpa_seq { <BREAK> } { \tl_use:N \l_tmpa_tl }
    \seq_remove_all:Nn \l_tmpa_seq { }
    \seq_set_map:NNn \l_tmpa_seq \l_tmpa_seq { \__codebox_dots_to_space:n {##1} }
    \seq_use:Nn \l_tmpa_seq { \\ }
    \end{minipage}
  }
  \group_end:
  \par
 }
\cs_new:Npn \__codebox_dots_to_space:n #1
 {
  \seq_set_split:Nnn \l_tmpb_seq { ... } { #1 }
  \exp_not:n { \seq_use:Nn \l_tmpb_seq { \hspace*{2em} } }
 }
\ExplSyntaxOff

