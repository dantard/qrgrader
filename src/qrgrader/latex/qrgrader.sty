\newcommand{\setexamid}[1]{%
    \newcount\examcount
    \newcount\examidcount
    \examcount=#1
    \divide\examcount by 1000
    \multiply\examcount by 1000
    \examidcount=#1
    \advance\examidcount by -\examcount
    \edef\examid{\the\examidcount}%
}

%GENERIC QUESTION
\newkeycommand*\question
[score=, penalty=, brief=, correct={a}, main=, ordered=, style={default,list,matrix,redundant,open,horizontal
},shownum={yes,no,none}, type={Q}][6]
{
    \ifcommandkey{main}{%
        \setexamid{\uniqueid}
        \pgfmathsetseed{\numexpr \commandkey{main} * 1 + \examid \relax}
        \pgfmathparse{random(100,999)}
        \edef\tentimes{\the\numexpr\pgfmathresult*10\relax}
        \ifnum\pdfstrcmp{\commandkey{ordered}}{no}=0
            \pgfmathsetseed{\numexpr #1 * 1 + \examid \relax}
            \pgfmathparse{random(1,8)}
        \else
            \pgfmathparse{1}
        \fi
        \edef\questionvalue{\the\numexpr\tentimes+\pgfmathresult\relax}
    }
    {
        \pgfmathparse{random(1000,9999)}
        \edef\questionvalue{\the\numexpr\pgfmathresult\relax}
    }
    %\pgfmathsetseed{1}
    \DTLnewrow{list}%
    
    \dtlexpandnewvalue
    \DTLnewdbentry{list}{id}{#1}%
    \dtlnoexpandnewvalue
    
    %\dtlexpandnewvalue
    \DTLnewdbentry{list}{label}{{\setstretch{1.15}\xspace#2}}%
    \DTLnewdbentry{list}{qa}{#3}%
    \DTLnewdbentry{list}{qb}{#4}%
    \DTLnewdbentry{list}{qc}{#5}%
    \DTLnewdbentry{list}{qd}{#6}%
    \DTLnewdbentry{list}{ok}{0}%
    \DTLnewdbentry{list}{appendix}{}

    \dtlexpandnewvalue
    \DTLnewdbentry{list}{main}{\ifcommandkey{main}{\commandkey{main}}{#1}}%
        \DTLnewdbentry{list}{correct}{\commandkey{correct}}%
        \DTLnewdbentry{list}{score}{\ifcommandkey{score}%{\textbf{($+$\commandkey{score}\hspace{-0.25em}}}{}
        {\textbf{($+$\commandkey{score}}}{}
        %\ifcommandkey{penalty}{\textbf{|$-$\commandkey{penalty})}}{\textbf{)}}
        \ifcommandkey{penalty}{\textbf{\texttt{|}$-$\commandkey{penalty}\hspace{0.00em})}}
        {\ifcommandkey{score}{\textbf{)}}{}} %0.55em
        }%
        \DTLnewdbentry{list}{style}{\commandkey{style}}
        \DTLnewdbentry{list}{shownum}{\commandkey{shownum}}
        \DTLnewdbentry{list}{value}{\questionvalue}
	\DTLnewdbentry{list}{brief}{\commandkey{brief}}
        %\DTLnewdbentry{list}{main}{\commandkey{main}}
    \dtlnoexpandnewvalue

    \typeout{;;;#1;;\commandkey{type};;\commandkey{correct};;
        \ifcommandkey{score}{\commandkey{score}}{0};;
        \ifcommandkey{penalty}{-\commandkey{penalty}}{0};;
        \ifcommandkey{brief}{\commandkey{brief}}{Empty};;
        \ifcommandkey{main}{\commandkey{main}}{#1};;;}


%    \mymessage{#2;;#3;;#4;;#5;;#6;;;}

    \expandafter\xdef\csname rnd #1\endcsname{\the\numexpr\pgfmathresult*1\relax}
}

\NewDocumentCommand{\subquestion}{O{} m m m m m m}{%
    \question[shownum=no,#1]{#2}{#3}{#4}{#5}{#6}{#7}
}


\NewDocumentCommand{\subanswer}{O{} m m m m m}{%
    \question[shownum=none,#1]{#2}{}{#3}{#4}{#5}{#6}
}

\newkeycommand*\stem[brief=, score=, penalty=, brief=, correct={a}, main=][3]
{       \setexamid{\uniqueid}
        \pgfmathsetseed{\numexpr #1 * 1 + \examid \relax}
        \pgfmathparse{random(100,999)}
        \edef\tentimes{\the\numexpr\pgfmathresult*10\relax}
        \DTLnewrow{list}%
        \DTLnewdbentry{list}{id}{#1}%
        \DTLnewdbentry{list}{label}{#3}%
        \DTLnewdbentry{list}{qa}{#2}%
        \DTLnewdbentry{list}{main}{#1}%
        \dtlexpandnewvalue
            \DTLnewdbentry{list}{style}{mainquestion}
            \DTLnewdbentry{list}{value}{\tentimes}
        \dtlnoexpandnewvalue
        \expandafter\xdef\csname rnd \theqn\endcsname{\the\numexpr\pgfmathresult*1\relax}
%        \typeout{;;;#1;;S;;\commandkey{correct};;
%        \ifcommandkey{score}{\commandkey{score}}{0};;
%        \ifcommandkey{penalty}{-\commandkey{penalty}}{0};;
%        \ifcommandkey{brief}{\commandkey{brief}}{Empty};;
%        \ifcommandkey{main}{\commandkey{main}}{#1};;;}
}

\newkeycommand*\vfillquestion[main=][1]
{       \setexamid{\uniqueid}
        \pgfmathsetseed{\numexpr \commandkey{main} * 1 + \examid \relax}
        \pgfmathparse{random(100,999)}
        \edef\tentimes{\the\numexpr\pgfmathresult*10\relax}
        \edef\questionvalue{\the\numexpr\tentimes+9\relax}
        \DTLnewrow{list}%
        %\DTLnewdbentry{list}{id}{#1}%
        \DTLnewdbentry{list}{label}{#1}%
        %\DTLnewdbentry{list}{qa}{#2}%
        \dtlexpandnewvalue
            \DTLnewdbentry{list}{style}{vfillquestion}
            \DTLnewdbentry{list}{value}{\questionvalue}
        \dtlnoexpandnewvalue
        \expandafter\xdef\csname rnd \theqn\endcsname{\the\numexpr\pgfmathresult*1\relax}
}


